/* Estilos para os botões de Entrar / Cadastrar e Perfil */
.auth-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-auth-login {
  background: transparent;
  border: 1px solid #2a2a2a;
  color: #fff;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
}

.btn-auth-register {
  background-color: #ff6b00;
  border: none;
  color: #fff;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
}

.user-profile-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #1a1a1a;
  border: 1px solid #2d2d2d;
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 0.75rem;
  color: #fff;
}

.user-avatar {
  width: 22px;
  height: 22px;
  background-color: #ff6b00;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 0.7rem;
}
